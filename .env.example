# Required. The OSRS Wiki blocks generic user agents, so name the project and give a contact.
FLIPWATCH_USER_AGENT=osrs-flipwatch (github.com/Jatzo/OSRS-Flipping-Tool)

# Optional. Defaults are shown.
FLIPWATCH_API_BASE_URL=https://prices.runescape.wiki/api/v1/osrs
FLIPWATCH_HTTP_TIMEOUT_SECONDS=10
FLIPWATCH_DB_PATH=flipwatch.sqlite3
# How long to keep stored price data. 0 keeps it forever.
FLIPWATCH_RETENTION_DAYS=90

# Dashboard alerts. Defaults are shown. ROI is a percentage and confidence is 0 to 100.
FLIPWATCH_ALERT_MIN_MARGIN=10
FLIPWATCH_ALERT_MIN_PROFIT=500000
FLIPWATCH_ALERT_MIN_ROI=1
FLIPWATCH_ALERT_MIN_VOLUME=50
FLIPWATCH_ALERT_MIN_CONFIDENCE=40
FLIPWATCH_ALERT_WATCHLIST_ONLY=false
FLIPWATCH_ALERT_COOLDOWN_MINUTES=60
